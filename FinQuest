<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FinQuest - Game Simulasi Keuangan Anak Asrama</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --accent: #0284c7;
            --accent-hover: #0369a1;
            --text-light: #f8fafc;
            --text-dim: #94a3b8;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .game-container {
            width: 100%;
            max-width: 800px;
            background-color: var(--card-bg);
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            border: 1px solid #334155;
        }

        header {
            text-align: center;
            margin-bottom: 20px;
            border-bottom: 1px solid #334155;
            padding-bottom: 12px;
        }

        h1 {
            color: var(--accent);
            font-size: 2rem;
            margin-bottom: 4px;
            letter-spacing: 1px;
        }

        .subtitle {
            color: var(--text-dim);
            font-size: 0.9rem;
        }

        .status-bar {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            background: #0f172a;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .stat-item {
            text-align: center;
        }

        .stat-label {
            font-size: 0.75rem;
            color: var(--text-dim);
            display: block;
        }

        .stat-value {
            font-size: 1.1rem;
            font-weight: bold;
        }

        .screen {
            display: none;
        }

        .screen.active {
            display: block;
        }

        .btn {
            background-color: var(--accent);
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            width: 100%;
            margin-top: 10px;
            transition: 0.2s;
        }

        .btn:hover {
            background-color: var(--accent-hover);
        }

        .input-group {
            margin-bottom: 12px;
        }

        .input-group label {
            display: block;
            font-size: 0.85rem;
            margin-bottom: 4px;
            color: var(--text-dim);
        }

        .input-group input {
            width: 100%;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid #475569;
            background: #0f172a;
            color: white;
            font-size: 1rem;
        }

        .event-box {
            background: #0f172a;
            padding: 16px;
            border-radius: 10px;
            border-left: 4px solid var(--accent);
            margin-bottom: 16px;
        }

        .event-title {
            font-weight: bold;
            color: var(--accent);
            margin-bottom: 6px;
        }

        .event-desc {
            font-size: 0.95rem;
            line-height: 1.4;
            margin-bottom: 12px;
        }

        .choice-btn {
            background: #334155;
            color: white;
            border: 1px solid #475569;
            padding: 10px;
            border-radius: 6px;
            width: 100%;
            text-align: left;
            margin-bottom: 8px;
            cursor: pointer;
            transition: 0.2s;
        }

        .choice-btn:hover {
            background: var(--accent);
            border-color: var(--accent);
        }

        .report-card {
            background: #0f172a;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #334155;
        }

        .score-big {
            font-size: 3rem;
            font-weight: bold;
            color: var(--success);
            text-align: center;
            margin: 10px 0;
        }

        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            background: var(--accent);
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

<div class="game-container">
    <header>
        <h1>FinQuest</h1>
        <div class="subtitle">Simulasi Kelola Uang Saku & Asrama Mahasiswa</div>
    </header>

    <!-- Top Status Bar -->
    <div class="status-bar" id="statusBar">
        <div class="stat-item">
            <span class="stat-label">❤️ Kesehatan</span>
            <span class="stat-value" id="valHealth">100</span>
        </div>
        <div class="stat-item">
            <span class="stat-label">😊 Kebahagiaan</span>
            <span class="stat-value" id="valHappiness">100</span>
        </div>
        <div class="stat-item">
            <span class="stat-label">🎓 Akademik</span>
            <span class="stat-value" id="valAcademic">100</span>
        </div>
    </div>

    <!-- SCREEN 1: START -->
    <div class="screen active" id="screenStart">
        <h2>Selamat Datang di Asrama! 👋</h2>
        <p style="margin: 12px 0; font-size: 0.95rem; color: var(--text-dim); line-height: 1.5;">
            Kamu memegang <b>uang saku Rp900.000/bulan</b>. Fasilitas dasar seperti WiFi, air, dan listrik asrama sudah ditanggung gratis. Tugasmu adalah mengelola uang saku selama 1 semester (Agustus - Desember) melewati UTS & UAS, krisis terduga, hingga peluang investasi.
        </p>
        <div class="input-group">
            <label for="playerName">Nama Panggilanmu:</label>
            <input type="text" id="playerName" placeholder="Misal: Budi">
        </div>
        <button class="btn" onclick="startGame()">Mulai Petualangan</button>
    </div>

    <!-- SCREEN 2: ALLOCATE BUDGET -->
    <div class="screen" id="screenBudget">
        <h3 id="budgetMonthTitle">Atur Anggaran Bulan Agustus</h3>
        <p style="font-size: 0.85rem; color: var(--text-dim); margin-bottom: 12px;">
            Total Uang Masuk: <b>Rp900.000</b>. (Note: Rp100.000 otomatis dialokasikan untuk Iuran Kas Wajib Asrama).
        </p>
        <div class="input-group">
            <label>1. Pos Survival (Uang Makan & Kas Asrama - Min. Rp450.000)</label>
            <input type="number" id="allocSurv" value="450000">
        </div>
        <div class="input-group">
            <label>2. Pos Akademik & Organisasi (Modul, Print, Kegiatan)</label>
            <input type="number" id="allocAcad" value="150000">
        </div>
        <div class="input-group">
            <label>3. Pos Proteksi & Darurat (Asuransi & Simpanan Tunai)</label>
            <input type="number" id="allocEmrg" value="150000">
        </div>
        <div class="input-group">
            <label>4. Pos Future (Tabungan Masa Depan)</label>
            <input type="number" id="allocFutu" value="150000">
        </div>
        <div id="budgetError" style="color: var(--danger); font-size: 0.85rem; margin-bottom: 8px;"></div>
        <button class="btn" onclick="submitBudget()">Kunci Anggaran Bulan Ini</button>
    </div>

    <!-- SCREEN 3: EVENT -->
    <div class="screen" id="screenEvent">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <span class="badge" id="eventBadge">Bulan 1 - Event 1</span>
            <span style="font-size: 0.8rem; color: var(--text-dim);" id="cashInfo">Dana Darurat: Rp0</span>
        </div>
        <div class="event-box">
            <div class="event-title" id="eventTitle">Judul Event</div>
            <div class="event-desc" id="eventDesc">Deskripsi event...</div>
            <div id="choiceContainer"></div>
        </div>
    </div>

    <!-- SCREEN 4: END REPORT -->
    <div class="screen" id="screenReport">
        <h3>🎉 Semester Selesai! Rapor Kompetensi FinQuest</h3>
        <p style="font-size: 0.85rem; color: var(--text-dim); margin-bottom: 12px;">Berikut adalah rekapitulasi performamu selama 1 semester mengelola keuangan asrama:</p>
        <div class="report-card">
            <div style="text-align: center; font-size: 0.9rem; color: var(--text-dim);" id="evalTitle">TINGKAT EVALUASI</div>
            <div class="score-big" id="finalScore">0</div>
            <p id="evalDesc" style="font-size: 0.9rem; line-height: 1.4; margin-bottom: 12px;"></p>
            <hr style="border-color: #334155; margin: 12px 0;">
            <div style="font-size: 0.85rem; line-height: 1.6;" id="detailReport"></div>
        </div>
        <button class="btn" style="margin-top: 16px;" onclick="location.reload()">Main Lagi dari Awal</button>
    </div>
</div>

<script>
    let player = {
        name: "Awardee",
        health: 100,
        happiness: 100,
        academic: 100,
        posSurv: 0,
        posAcad: 0,
        posEmrg: 0,
        posFutu: 0,
        hasHealthtech: false,
        hasMotorProt: false,
        reksadana: 0,
        hasPinjol: false
    };

    let currentMonthIdx = 0;
    let currentEventIdx = 0;

    const months = ["Agustus", "September", "Oktober (Pekan UTS)", "November", "Desember (Pekan UAS)"];

    // Struktur Multi-Event Baru per Bulan
    const monthEvents = [
        // BULAN 1: AGUSTUS (Adaptasi, Budgeting & Proteksi Awal)
        [
            {
                title: "Opsi Proteksi Awal Semester (Pasar Asuransi Astra)",
                desc: "Di awal semester, kamu bisa membeli proteksi mikro dari Pos Proteksi & Darurat agar siap menghadapi risiko ke depan.",
                choices: [
                    { text: "Beli Garda Healthtech (Rp30.000 / semester)", action: () => {
                        if(player.posEmrg >= 30000) { player.posEmrg -= 30000; player.hasHealthtech = true; alert("✅ Garda Healthtech aktif! Kamu terlindungi dari biaya medis rawat jalan."); }
                        else { alert("❌ Dana di Pos Proteksi kurang!"); }
                    }},
                    { text: "Beli Paket Lengkap: Garda Healthtech + Garda Motor (Rp50.000)", action: () => {
                        if(player.posEmrg >= 50000) { player.posEmrg -= 50000; player.hasHealthtech = true; player.hasMotorProt = true; alert("✅ Garda Healthtech & Garda Motor aktif!"); }
                        else { alert("❌ Dana di Pos Proteksi kurang!"); }
                    }},
                    { text: "Tidak membeli asuransi dulu", action: () => { alert("Kamu memilih tidak mengambil proteksi di awal semester."); }}
                ]
            },
            {
                title: "Keinginan vs Kebutuhan Kampus",
                desc: "Anak-anak angkatan mengajak nongkrong di kafe hits habis kuliah (Bayar Rp45.000), tapi Dosen mewajibkan beli Buku Teks Utama (Bayar Rp50.000).",
                choices: [
                    { text: "Prioritaskan Beli Buku Teks Dosen (Rp50.000 dari Pos Akademik)", action: () => {
                        if(player.posAcad >= 50000) { player.posAcad -= 50000; player.academic += 5; }
                        else { player.academic -= 10; alert("Pos Akademik tidak cukup!"); }
                    }},
                    { text: "Ikut Nongkrong di Kafe (Rp45.000 dari Pos Survival)", action: () => {
                        if(player.posSurv >= 45000) { player.posSurv -= 45000; player.happiness += 10; player.academic -= 5; }
                        else { player.happiness -= 5; alert("Uang Pos Survival pas-pasan!"); }
                    }}
                ]
            },
            {
                title: "Kesehatan: Perubahan Cuaca Asrama",
                desc: "Perubahan cuaca & adaptasi lingkungan asrama bikin kamu kena radang tenggorokan ringan. Perlu beli obat toko seharga Rp15.000.",
                choices: [
                    { text: "Beli obat radang toko (Rp15.000)", action: () => {
                        if(player.hasHealthtech) { alert("🛡️ Tercover Garda Healthtech! Biaya obat Rp0."); }
                        else if(player.posEmrg >= 15000) { player.posEmrg -= 15000; }
                        else { player.health -= 10; alert("Dana darurat tidak cukup, ditahan sakitnya. (Kesehatan -10)"); }
                    }}
                ]
            }
        ],

        // BULAN 2: SEPTEMBER (Dinamika Organisasi & Asrama)
        [
            {
                title: "Tugas Kelompok & Kuota Zoom Mendadak",
                desc: "Tugas kelompok membuat laporan cetak/jilid dan butuh kuota besar untuk zoom meeting mendadak (Biaya Rp35.000).",
                choices: [
                    { text: "Bayar dari Pos Akademik (Rp35.000)", action: () => {
                        if(player.posAcad >= 35000) { player.posAcad -= 35000; }
                        else { player.academic -= 15; alert("Pos Akademik kurang! Nilai Akademik drop -15."); }
                    }}
                ]
            },
            {
                title: "Fasilitas Asrama Rusak Bersamaan",
                desc: "Tabung gas & pompa air asrama habis/rusak bersamaan. Ada patungan darurat anak asrama sebesar Rp25.000.",
                choices: [
                    { text: "Bayar patungan dari Dana Darurat (Rp25.000)", action: () => {
                        if(player.posEmrg >= 25000) { player.posEmrg -= 25000; player.happiness += 5; }
                        else { player.happiness -= 15; alert("Gagal bayar patungan! Konflik dengan anak asrama. (Kebahagiaan -15)"); }
                    }}
                ]
            },
            {
                title: "Dilema Baju Kotor Menumpuk",
                desc: "Jadwal harian padat banget. Pilih Laundry Express (Rp30.000) atau cuci sendiri di asrama?",
                choices: [
                    { text: "Laundry Express (Rp30.000 dari Pos Survival)", action: () => {
                        if(player.posSurv >= 30000) { player.posSurv -= 30000; player.health += 5; }
                        else { player.health -= 5; alert("Pos Survival kurang untuk laundry!"); }
                    }},
                    { text: "Cuci Sendiri di Asrama (Hemat Rp0, Tapi Capek)", action: () => { player.health -= 5; }}
                ]
            }
        ],

        // BULAN 3: OKTOBER (Pekan UTS & Simulasi Krisis Sedang)
        [
            {
                title: "EVENT KHUSUS UTS: Cetak Berkas Ujian Mendadak",
                desc: "Wajib cetak berkas ujian/modul praktikum UTS mendadak sebelum ujian dimulai (Bayar Rp25.000). Jika tidak dibayar, Nilai Akademik drop -15 Poin.",
                choices: [
                    { text: "Bayar dari Pos Akademik (Rp25.000)", action: () => {
                        if(player.posAcad >= 25000) { player.posAcad -= 25000; alert("Ujian UTS lancar!"); }
                        else { player.academic -= 15; alert("Gagal cetak berkas! Nilai Akademik drop -15."); }
                    }}
                ]
            },
            {
                title: "Darurat Kendaraan Pas UTS",
                desc: "Ban motor bocor & kampas rem habis saat buru-buru berangkat ujian UTS (Biaya Rp55.000).",
                choices: [
                    { text: "Gunakan Dana Darurat / Proteksi Motor", action: () => {
                        if(player.hasMotorProt) { alert("🛡️ Tercover Garda Motor! Servis gratis Rp0."); }
                        else if(player.posEmrg >= 55000) { player.posEmrg -= 55000; alert("Perbaikan dibayar dari Dana Darurat Tunai."); }
                        else { player.posSurv -= 55000; player.happiness -= 10; alert("Dana Darurat tidak cukup, terpaksa potong uang makan! (Kebahagiaan -10)"); }
                    }}
                ]
            },
            {
                title: "KRISIS MEDIS UTS: Tumbang Demam H-1 Ujian",
                desc: "Tumbang flu berat & demam tinggi saat minggu UTS karena stres & begadan. Harus berobat ke klinik dan beli obat senilai Rp180.000!",
                choices: [
                    { text: "Eksekusi Solusi Berobat", action: () => {
                        if(player.hasHealthtech) {
                            alert("🛡️ KARTU GARDA HEALTHTECH AKTIF! Tagihan Rp180.000 ditanggung penuh oleh Astra (Bayar Rp0). Kamu pulih tepat waktu!");
                            player.health += 5;
                        } else if(player.posEmrg >= 180000) {
                            player.posEmrg -= 180000; player.health -= 5;
                            alert("Dibayar dari Dana Darurat Tunai. Tabungan daruratmu langsung menipis!");
                        } else if(player.posFutu >= 180000) {
                            player.posFutu -= 180000; player.health -= 5;
                            alert("Dana darurat tidak cukup, terpaksa kuras tabungan di Pos Future!");
                        } else {
                            player.hasPinjol = true; player.happiness -= 25; player.health -= 15;
                            alert("❌ UANG TIDAK CUKUP! Terjebak pinjol/utang konsumtif. Kebahagiaan & Kesehatan drop parah!");
                        }
                    }}
                ]
            }
        ],

        // BULAN 4: NOVEMBER (Literasi Investasi & Event FOMO)
        [
            {
                title: "Peluang Investasi Reksadana Pasar Uang",
                desc: "Setelah UTS berlalu, suasana tenang. Pos Future yang aman bisa kamu pindahkan ke Reksadana Pasar Uang (Potensi Bonus +10% di akhir semester).",
                choices: [
                    { text: "Pindahkan Rp100.000 dari Pos Future ke Reksadana", action: () => {
                        if(player.posFutu >= 100000) { player.posFutu -= 100000; player.reksadana += 110000; alert("✅ Berhasil dikembangkan ke Reksadana (+10% Bonus)!"); }
                        else { alert("Sisa dana Pos Future tidak cukup!"); }
                    }},
                    { text: "Biarkan tetap di tabungan biasa", action: () => {} }
                ]
            },
            {
                title: "Ujian FOMO & Jebakan Finansial",
                desc: "Teman kampus mengajak ikut trading crypto/skema cepat kaya iming-iming untung 50% sehari, atau godaan paylater/pinjol beli baju acara kampus.",
                choices: [
                    { text: "Tolak FOMO & Tetap Disiplin (Kebahagiaan +10)", action: () => { player.happiness += 10; alert("Keputusan bijak! Kebahagiaan +10."); }},
                    { text: "Ikut FOMO / Skema Spekulasi", action: () => { player.happiness -= 25; player.posFutu = 0; player.reksadana = 0; alert("🚨 Rungkad! Seluruh tabungan hilang & Kebahagiaan -25 Poin."); }}
                ]
            },
            {
                title: "Sosial Asrama: Program Berbagi Sukarela",
                desc: "Anak-anak asrama mengadakan program berbagi/infaq sukarela seharga Rp20.000.",
                choices: [
                    { text: "Ikut Berbagi (Rp20.000 dari Pos Survival)", action: () => { if(player.posSurv >= 20000) { player.posSurv -= 20000; player.happiness += 10; } }},
                    { text: "Lewati dulu bulan ini", action: () => {} }
                ]
            }
        ],

        // BULAN 5: DESEMBER (Pekan UAS & Peak Difficulty)
        [
            {
                title: "EVENT KHUSUS UAS: Cetak Jilid Hardcover Praktikum",
                desc: "Pengumpulan Tugas Akhir Semester & Cetak Jilid Hardcover Praktikum wajib dikumpul (Bayar Rp60.000).",
                choices: [
                    { text: "Bayar dari Pos Akademik (Rp60.000)", action: () => {
                        if(player.posAcad >= 60000) { player.posAcad -= 60000; player.academic += 5; }
                        else { player.academic -= 20; alert("Nilai UAS berkurang karena telat cetak!"); }
                    }}
                ]
            },
            {
                title: "KRISIS BESAR UAS: Laptop Mati Total Pas H-2 UAS",
                desc: "Musibah laptop mati total/kena virus pas H-2 pengumpulan Draf Akhir UAS. Membutuhkan servis cepat Rp250.000!",
                choices: [
                    { text: "Bayar Servis Laptop Cepat (Rp250.000)", action: () => {
                        let total = player.posEmrg + player.posFutu;
                        if(total >= 250000) {
                            if(player.posEmrg >= 250000) { player.posEmrg -= 250000; }
                            else { let sisa = 250000 - player.posEmrg; player.posEmrg = 0; player.posFutu -= sisa; }
                            alert("✅ Laptop beres tepat waktu! Draf UAS terselamatkan.");
                        } else {
                            player.academic -= 25; player.happiness -= 20;
                            alert("❌ Dana tidak cukup! File hilang, UAS berantakan (Akademik -25, Kebahagiaan -20).");
                        }
                    }}
                ]
            },
            {
                title: "Persiapan Pulang Kampung Liburan Semester",
                desc: "Beli tiket kereta/bus liburan semester (Bayar Rp150.000).",
                choices: [
                    { text: "Beli Tiket dari Tabungan Pos Future (Rp150.000)", action: () => {
                        if(player.posFutu >= 150000) { player.posFutu -= 150000; player.happiness += 15; alert("Pulang kampung tenang!"); }
                        else { player.happiness -= 15; alert("Tabungan habis! Terpaksa utang teman (Kebahagiaan drop)."); }
                    }}
                ]
            }
        ]
    ];

    function updateUI() {
        player.health = Math.max(0, Math.min(100, player.health));
        player.happiness = Math.max(0, Math.min(100, player.happiness));
        player.academic = Math.max(0, Math.min(100, player.academic));

        document.getElementById('valHealth').innerText = player.health;
        document.getElementById('valHappiness').innerText = player.happiness;
        document.getElementById('valAcademic').innerText = player.academic;
    }

    function showScreen(screenId) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById(screenId).classList.add('active');
        updateUI();
    }

    function startGame() {
        let nameInput = document.getElementById('playerName').value;
        if(nameInput.trim() !== "") player.name = nameInput;
        currentMonthIdx = 0;
        startMonthBudget();
    }

    function startMonthBudget() {
        document.getElementById('budgetMonthTitle').innerText = `Atur Anggaran Bulan ${months[currentMonthIdx]}`;
        document.getElementById('budgetError').innerText = "";
        showScreen('screenBudget');
    }

    function submitBudget() {
        let surv = parseInt(document.getElementById('allocSurv').value) || 0;
        let acad = parseInt(document.getElementById('allocAcad').value) || 0;
        let emrg = parseInt(document.getElementById('allocEmrg').value) || 0;
        let futu = parseInt(document.getElementById('allocFutu').value) || 0;

        let total = surv + acad + emrg + futu;

        if(total !== 900000) {
            document.getElementById('budgetError').innerText = `Total alokasimu Rp${total.toLocaleString('id-ID')}. Harus pas Rp900.000!`;
            return;
        }

        if(surv < 100000) {
            document.getElementById('budgetError').innerText = "Pos Survival minimal Rp100.000 untuk Iuran Kas Wajib Asrama!";
            return;
        }

        player.posSurv += (surv - 100000); // Rp100.000 otomatis kepotong Kas Asrama
        player.posAcad += acad;
        player.posEmrg += emrg;
        player.posFutu += futu;

        if(surv < 400000) {
            player.health -= 10;
            player.happiness -= 5;
            alert("Budget makanmu terlalu kecil! Kesehatan & Kebahagiaan agak drop.");
        }

        currentEventIdx = 0;
        loadEvent();
    }

    function loadEvent() {
        let monthName = months[currentMonthIdx];
        let events = monthEvents[currentMonthIdx];

        if(currentEventIdx >= events.length) {
            currentMonthIdx++;
            if(currentMonthIdx >= months.length) {
                finishGame();
            } else {
                startMonthBudget();
            }
            return;
        }

        let ev = events[currentEventIdx];
        document.getElementById('eventBadge').innerText = `${monthName} (Kasus ${currentEventIdx + 1}/${events.length})`;
        
        document.getElementById('cashInfo').innerText = `Dana Darurat: Rp${player.posEmrg.toLocaleString('id-ID')}`;

        document.getElementById('eventTitle').innerText = ev.title;
        document.getElementById('eventDesc').innerText = ev.desc;

        let container = document.getElementById('choiceContainer');
        container.innerHTML = "";

        ev.choices.forEach((c) => {
            let btn = document.createElement('button');
            btn.className = 'choice-btn';
            btn.innerText = c.text;
            btn.onclick = () => {
                c.action();
                currentEventIdx++;
                loadEvent();
            };
            container.appendChild(btn);
        });

        showScreen('screenEvent');
    }

    function finishGame() {
        let totalSavings = player.posFutu + player.reksadana;
        let savingsScore = 0;

        if(player.hasPinjol) savingsScore = 0;
        else if(totalSavings >= 400000) savingsScore = 100;
        else if(totalSavings >= 200000) savingsScore = 75;
        else if(totalSavings >= 100000) savingsScore = 50;
        else savingsScore = 25;

        let avgInd = (player.health + player.happiness + player.academic) / 3.0;
        let finalScore = Math.round((avgInd * 0.6) + (savingsScore * 0.4));

        document.getElementById('finalScore').innerText = `${finalScore} / 100`;

        let title = "";
        let desc = "";

        if(finalScore >= 85) {
            title = "👑 FINANCIAL PLANNER MUDA (SANGAT KOMPETEN)";
            desc = "Luar biasa! Kamu berhasil menjaga kesehatan, keharmonisan asrama, nilai perkuliahan tetap tinggi, serta memiliki kesadaran mitigasi risiko yang sangat matang!";
        } else if(finalScore >= 75) {
            title = "🏆 MANAJER KEUANGAN HANDAL (KOMPETEN)";
            desc = "Pengelolaan keuanganmu sangat baik. Keuangan tetap stabil walau ada sedikit kompromi pada tabungan akhir.";
        } else if(finalScore >= 60) {
            title = "⚖️ CUKUP SEIMBANG (CUKUP KOMPETEN)";
            desc = "Kamu bertahan tanpa utang, namun sempat keteteran saat krisis fisik/fasilitas karena mengabaikan asuransi di awal semester.";
        } else if(finalScore >= 45) {
            title = "⚠️ KURANG EFISIEN (CENDERUNG RENTAN)";
            desc = "Tabungan habis dan kesehatan drop akibat sering memotong alokasi uang makan demi kebutuhan terduga.";
        } else {
            title = "🚨 PERLU EVALUASI TOTAL (BELUM KOMPETEN)";
            desc = "Kamu mengalami defisit keuangan, abai kas asrama, atau terjebak pinjol/utang konsumtif. Terapkan alokasi ideal 50-15-15-20 di semester depan!";
        }

        document.getElementById('evalTitle').innerText = title;
        document.getElementById('evalDesc').innerText = desc;

        document.getElementById('detailReport').innerHTML = `
            <b>Statistik Akhir ${player.name}:</b><br>
            • Indikator: Kesehatan (${player.health}) | Kebahagiaan (${player.happiness}) | Akademik (${player.academic})<br>
            • Total Sisa Tabungan & Investasi: <b>Rp${totalSavings.toLocaleString('id-ID')}</b><br>
            • Status Proteksi Asuransi Astra: <b>${player.hasHealthtech ? 'Aktif (Garda Healthtech)' : 'Tidak Ada'}</b><br>
            • Status Utang: <b>${player.hasPinjol ? 'Terjebak Pinjol/Utang ❌' : 'Bebas Utang ✅'}</b>
        `;

        showScreen('screenReport');
    }
</script>

