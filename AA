        e3 = input("Pilihan (1/2): ")
        if e3 == "1" and self.player.pos_survival >= 30000:
            self.player.pos_survival -= 30000
            self.player.health += 5
        else:
            self.player.health -= 5

    def month_october(self):
        print("\n📌 --- BULAN 3: OKTOBER (Pekan UTS & Simulasi Krisis) ---")
        self.allocate_budget("Oktober")
        
        print("\n🎴 [EVENT 1/3 - UTS] Cetak Lembar Kerja Ujian Praktikum Mendadak (Rp25.000)")
        if self.player.pos_academic >= 25000:
            self.player.pos_academic -= 25000
            print("✅ Lembar ujian tercetak! Akademik aman.")
        else:
            self.player.academic -= 20
