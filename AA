            self.player.pos_emergency -= 180000
            print("✅ Dibayar penuh dari Dana Darurat Tunai.")
        else:
            print("🚨 DANA DARURAT TIDAK CUKUP!")
            print("1. Ambil dari Tabungan Pos Future")
            print("2. Terjebak Pinjol Cepat Cair")
            e3 = input("Pilih solusi darurat (1/2): ")
            if e3 == "1" and self.player.pos_future >= 180000:
                self.player.pos_future -= 180000
