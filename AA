class Player:
    def __init__(self, name):
        self.name = name
        self.allowance = 900000
        self.cash = 0
        
        # Indikator Utama (Skala 0 - 100)
        self.health = 100
        self.happiness = 100
        self.academic = 100
        
        # Alokasi Pos Anggaran
        self.pos_survival = 0    # Makan & Kas Asrama
        self.pos_academic = 0    # Modul, Cetak Tugas, Kas Himpunan
        self.pos_emergency = 0   # Dana Darurat Tunai
        self.pos_future = 0      # Tabungan / Investasi
        
        # Status Aset & Proteksi
        self.has_garda_healthtech = False
        self.has_garda_motor = False
        self.reksadana_amount = 0
        self.has_pinjol = False

    def cap_stats(self):
        self.health = max(0, min(100, self.health))
        self.happiness = max(0, min(100, self.happiness))
        self.academic = max(0, min(100, self.academic))

    def print_status(self):
        print("\n" + "="*50)
        print(f" 📊 STATUS FINQUEST: {self.name.upper()}")
        print("="*50)
        print(f" ❤️ Kesehatan  : {self.health}/100")
        print(f" 😊 Kebahagiaan: {self.happiness}/100")
        print(f" 🎓 Akademik   : {self.academic}/100")
        print("-" * 50)
        print(f" 💵 Cash Tangan : Rp{self.cash:,}")
        print(f" 🛡️ Garda Health: {'AKTIF' if self.has_garda_healthtech else 'TIDAK ADA'}")
        print(f" 🛡️ Garda Motor : {'AKTIF' if self.has_garda_motor else 'TIDAK ADA'}")
        print(f" 📈 Reksadana   : Rp{self.reksadana_amount:,}")
        print(f" 💰 Total Tabungan (Pos Future): Rp{self.pos_future:,}")
        print("="*50 + "\n")

