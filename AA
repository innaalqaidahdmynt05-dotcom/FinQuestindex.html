    def month_november(self):
        print("\n📌 --- BULAN 4: NOVEMBER (Literasi Investasi & Ujian FOMO) ---")
        self.allocate_budget("November")
        
        print("\n📈 [PASAR INVESTASI BUKA]")
        print(f"Sisa Tabungan di Pos Future saat ini: Rp{self.player.pos_future:,}")
        if self.player.pos_future > 0:
            inv = input("Berapa yang mau dipindahkan ke Reksadana Pasar Uang? Rp")
            try:
                inv_val = int(inv)
                if inv_val <= self.player.pos_future:
                    self.player.pos_future -= inv_val
                    self.player.reksadana_amount += int(inv_val * 1.10) # Return +10%
                    print(f"✅ Berhasil! Rp{inv_val:,} diinvestasikan di Reksadana (Proyeksi Bonus +10%).")
            except ValueError:
                pass

        print("\n🎴 [EVENT 1/3] Ajak Crypto/Skema Cepat Kaya dari Teman Kampus")
        print("1. Ikut Crypto (Spekulasi Rp100.000)")
        print("2. Menolak halus & tetap di Reksadana/Tabungan")
        e1 = input("Pilihan (1/2): ")
        if e1 == "1":
            print("❌ Rugi Crypto/Rungkad! Uang Rp100.000 hilang. Kebahagiaan -15.")
            self.player.happiness -= 15
        else:
            self.player.happiness += 10
            print("✅ Bijak! Menghindari judi terselubung. Kebahagiaan +10.")

        print("\n🎴 [EVENT 2/3] Program Berbagi Infaq Asrama Bright Scholarship (Rp20.000)")
        if self.player.pos_survival >= 20000:
            self.player.pos_survival -= 20000
            self.player.happiness += 10
            print("✅ Berbagi kebaikan. Kebahagiaan +10 Poin.")

        print("\n🎴 [EVENT 3/3] Cetak Modul Persiapan UAS (Rp30.000)")
        if self.player.pos_academic >= 30000:
            self.player.pos_academic -= 30000
            print("✅ Dibayar dari Pos Akademik.")
        else:
            self.player.academic -= 10

    def month_december(self):
        print("\n📌 --- BULAN 5: DESEMBER (Pekan UAS & Peak Difficulty) ---")
        self.allocate_budget("Desember")
        
        print("\n🎴 [EVENT 1/3 - UAS] Cetak & Jilid Hardcover Tugas Akhir Semester (Rp60.000)")
        if self.player.pos_academic >= 60000:
            self.player.pos_academic -= 60000
            print("✅ Tugas Akhir terjilid rapi! Akademik +5.")
            self.player.academic += 5
        else:
            self.player.academic -= 20
            print("❌ Gagal jilid hardcover tepat waktu! Akademik -20 Poin.")

        print("\n🎴 [EVENT 2/3 - KRISIS BESAR] Servis Laptop Mati Total H-2 Draf UAS (Rp250.000)")
        total_darurat = self.player.pos_emergency + self.player.pos_future
        if total_darurat >= 250000:
            if self.player.pos_emergency >= 250000:
                self.player.pos_emergency -= 250000
            else:
                sisa = 250000 - self.player.pos_emergency
                self.player.pos_emergency = 0
                self.player.pos_future -= sisa
            print("✅ Servis laptop selesai! Tugas UAS terselamatkan berkat Dana Darurat/Tabungan.")
        else:
            self.player.academic -= 25
            self.player.happiness -= 20
            print("❌ Dana tidak cukup! File hilang, UAS berantakan (Akademik -25, Kebahagiaan -20).")

        print("\n🎴 [EVENT 3/3] Tiket Pulang Kampung Liburan Semester (Rp150.000)")
        if self.player.pos_future >= 150000:
            self.player.pos_future -= 150000
            self.player.happiness += 15
            print("✅ Tiket kereta terbeli dari tabungan! Pulang kampung tenang.")
        else:
            self.player.happiness -= 10
            print("⚠️ Tabungan kurang. Harus pinjam teman/tidak bisa pulang kampung tepat waktu.")

    def evaluate_game(self):
        self.player.cap_stats()
        
        # Total Wealth Calculation
        total_savings = self.player.pos_future + self.player.reksadana_amount
        
        if self.player.has_pinjol:
            savings_score = 0
        elif total_savings >= 400000:
            savings_score = 100
        elif total_savings >= 200000:
            savings_score = 75
        elif total_savings >= 100000:
            savings_score = 50
        else:
            savings_score = 25
            
        avg_indicator = (self.player.health + self.player.happiness + self.player.academic) / 3.0
        final_score = (avg_indicator * 0.6) + (savings_score * 0.4)
        
        print("\n" + "="*60)
        print(" 🎓 RAPOR EVALUASI FINQUEST - BRIGHT SCHOLARSHIP EDITION")
        print("="*60)
        print(f" Nama Player        : {self.player.name}")
        print(f" Rata-rata Indikator: {avg_indicator:.1f} / 100 (Bobot 60%)")
        print(f" Sisa Tabungan      : Rp{total_savings:,} (Skor Tabungan: {savings_score}/100 - Bobot 40%)")
        print(f" Status Pinjol      : {'ADA UTANG PINJOL' if self.player.has_pinjol else 'BEBAS UTANG'}")
        print("-" * 60)
        print(f" 🏆 TOTAL SKOR FINQUEST: {final_score:.1f} / 100")
        print("-" * 60)
        
        if final_score >= 85:
            print(" 👑 TINGKAT 1: FINANCIAL PLANNER MUDA (SANGAT KOMPETEN)")
            print(" Evaluasi: Mampu menjaga kesehatan, hubungan asrama, akademik tinggi, & siap terproteksi Asuransi Astra!")
        elif final_score >= 75:
            print(" 🏆 TINGKAT 2: MANAJER KEUANGAN HANDAL (KOMPETEN)")
            print(" Evaluasi: Pengelolaan keuangan baik, namun tabungan sedikit tergerus konsumsi rekreasi.")
        elif final_score >= 60:
            print(" ⚖️ TINGKAT 3: CUKUP SEIMBANG (CUKUP KOMPETEN)")
            print(" Evaluasi: Bertahan tanpa utang, namun sempat keteteran saat krisis karena kurang proteksi.")
        elif final_score >= 45:
            print(" ⚠️ TINGKAT 4: KURANG EFISIEN (CENDERUNG RENTAN)")
            print(" Evaluasi: Tabungan habis & kesehatan terganggu akibat sering memotong alokasi makan.")
        else:
            print(" 🚨 TINGKAT 5: PERLU EVALUASI TOTAL (BELUM KOMPETEN)")
            print(" Evaluasi: Defisit keuangan, abai kas asrama, atau terjebak pinjol. Terapkan rumus 50-30-20!")
        print("="*60 + "\n")

    def start(self):
        self.banner()
        name = input("Masukkan nama Awardee / Player: ").strip()
        if not name:
            name = "Awardee Bright"
        self.player = Player(name)
        
        # Loop Months
        self.month_august()
        self.player.print_status()
        
        self.month_september()
        self.player.print_status()
        
        self.month_october()
        self.player.print_status()
        
        self.month_november()
        self.player.print_status()
        
        self.month_december()
        self.player.print_status()
        
        # End Game Evaluation
        self.evaluate_game()

if __name__ == "__main__":
    game = FinQuestGame()
    game.start()
