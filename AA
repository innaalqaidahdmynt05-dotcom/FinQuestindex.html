    def allocate_budget(self, month_name):
        print(f"\n💵 [ALOKASI ANGGARAN BULAN {month_name.upper()}]")
        print("Uang saku bulanan Bright Scholarship masuk: Rp900.000")
        self.player.cash += self.player.allowance
        
        print("\nSusun alokasi 4 Pos Anggaranmu untuk bulan ini:")
        print("Catatan: Kas Wajib Asrama adalah Rp100.000 (Potong Pos Survival)")
        
        while True:
            try:
                surv = int(input("1. Pos Survival (Min. Rp450k untuk Kas Rp100k + Makan) : Rp"))
                acad = int(input("2. Pos Akademik & Organisasi                        : Rp"))
                emrg = int(input("3. Pos Proteksi & Darurat                           : Rp"))
                futu = int(input("4. Pos Future (Tabungan)                            : Rp"))
                
                total = surv + acad + emrg + futu
                if total != self.player.cash:
                    print(f"\n⚠️ Total alokasi (Rp{total:,}) tidak sama dengan cashmu (Rp{self.player.cash:,})! Ulangi.")
                    continue
                
                if surv < 100000:
                    print("\n⚠️ Pos Survival minimal Rp100.000 untuk bayar Kas Asrama Wajib!")
                    continue
                
                self.player.pos_survival = surv - 100000  # Rp100k langsung kepotong Kas Asrama
                self.player.pos_academic += acad
                self.player.pos_emergency += emrg
                self.player.pos_future += futu
                self.player.cash = 0
                
                print(f"\n✅ Anggaran Berhasil Disusun! Rp100.000 otomatis terbayar untuk Kas Asrama.")
                if surv < 400000:
                    print("⚠️ Budget makan terlalu kecil! Risiko indikator kesehatan turun.")
                    self.player.health -= 10
                    self.player.happiness -= 5
                break
            except ValueError:
                print("⚠️ Masukkan angka yang valid!")

    def month_august(self):
        print("\n📌 --- BULAN 1: AGUSTUS (Adaptasi, Budgeting & Proteksi) ---")
        self.allocate_budget("Agustus")
        
        # Pasar Proteksi Astra
        print("\n🛡️ [PASAR PROTEKSI ASTRA BUKA (SPECIAL AGUSTUS)]")
        print("Mumpung awal semester, lindungi dirimu dengan Asuransi Astra Mikro:")
        print("1. Garda Healthtech (Rp30.000 / semester) -> Cover Biaya Berobat Sakit")
        print("2. Garda Motor (Rp20.000 / semester)      -> Cover Perbaikan Motor")
        print("3. Tidak beli dulu")
        
        choice = input("Pilih proteksi (misal 1 / 1,2 / 3): ").strip()
        if "1" in choice and self.player.pos_emergency >= 30000:
            self.player.pos_emergency -= 30000
            self.player.has_garda_healthtech = True
            print("✅ Garda Healthtech Aktif!")
        if "2" in choice and self.player.pos_emergency >= 20000:
            self.player.pos_emergency -= 20000
            self.player.has_garda_motor = True
            print("✅ Garda Motor Aktif!")
            
        # Multi-Events
        print("\n🎴 [EVENT 1/3] Diajak nongkrong angkatan di kafe hits (Bayar Rp45.000)")
        print("1. Ikut nongkrong (Pakai Pos Survival)")
        print("2. Skip nongkrong & fokus asrama")
        e1 = input("Pilihanmu (1/2): ")
        if e1 == "1" and self.player.pos_survival >= 45000:
            self.player.pos_survival -= 45000
            self.player.happiness += 10
        else:
            self.player.happiness -= 5

        print("\n🎴 [EVENT 2/3] Beli Buku Teks Utama Dosen (Bayar Rp50.000)")
        if self.player.pos_academic >= 50000:
            self.player.pos_academic -= 50000
            self.player.academic += 5
            print("✅ Dibayar via Pos Akademik.")
        else:
            print("❌ Uang Pos Akademik kurang! Akademik -15 Poin.")
            self.player.academic -= 15

        print("\n🎴 [EVENT 3/3] Adaptasi cuaca asrama bikin radang (Obat Rp15.000)")
        if self.player.has_garda_healthtech:
            print("🛡️ Garda Healthtech Aktif! Obat dicover penuh oleh Astra (Bayar Rp0).")
        elif self.player.pos_emergency >= 15000:
            self.player.pos_emergency -= 15000
            print("✅ Dibayar via Dana Darurat Tunai.")
        else:
            self.player.health -= 10
            print("❌ Tidak ada dana darurat! Kesehatan -10 Poin.")

    def month_september(self):
        print("\n📌 --- BULAN 2: SEPTEMBER (Dinamika Organisasi & Asrama) ---")
        self.allocate_budget("September")
        
        print("\n🎴 [EVENT 1/3] Tugas Kelompok & Print Laporan (Rp35.000)")
        if self.player.pos_academic >= 35000:
            self.player.pos_academic -= 35000
